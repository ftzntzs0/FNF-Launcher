<Window
    x:Class="FNFVsliceLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FNFVsliceLauncher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FNF V-Slice Mod Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" VerticalAlignment="Top" Height="32">
            <TextBlock x:Name="AppTitle" Text="FNF V-Slice Mod Launcher" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <Grid Grid.Row="1" Background="Transparent">
            <NavigationView x:Name="NavView" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged">

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
                </NavigationView.MenuItems>


                <Grid Padding="20">
                <Grid x:Name="HomeGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="My Installed Mods" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshMods_Click" VerticalAlignment="Center" Padding="8">
                            <SymbolIcon Symbol="Refresh"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock x:Name="StatusText" Foreground="Gray" FontStyle="Italic"/>
                    </StackPanel>

                    <GridView Grid.Row="2" x:Name="ModsGridView" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ModItem">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" CornerRadius="8" 
                                        Width="280" Height="360" Margin="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="220"/>
                                           
                                            <RowDefinition Height="*"/>
                                           
                                            <RowDefinition Height="Auto"/>
                                       
                                        </Grid.RowDefinitions>

                                        <Image Source="{x:Bind IconPath, Mode=OneWay}" Stretch="UniformToFill" 
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                        <Rectangle Grid.Row="0" Fill="{ThemeResource SystemAccentColor}" Opacity="0.1"/>

                                        <Border Grid.Row="0" CornerRadius="8,8,0,0" 
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>

                                        
                                        <StackPanel Grid.Row="1" Padding="15,15,15,5" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="16" 
                                                TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" TextWrapping="Wrap"/>

                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" TextTrimming="WordEllipsis" 
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Height="40"/>
                                        </StackPanel>

                                        
                                        <Button Grid.Row="2" 
                                            x:Name="PlayButton"
                                            HorizontalAlignment="Stretch" 
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="LaunchMod_Click" 
                                            Tag="{x:Bind}" 
                                            IsEnabled="{x:Bind IsPlayable, Mode=OneWay}" 
                                            Margin="15,0,15,15"
                                            PointerEntered="PlayButton_PointerEntered"
                                            PointerExited="PlayButton_PointerExited">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon x:Name="PlayIcon" Symbol="{x:Bind local:MainWindow.GetIconSymbol(IsRunning), Mode=OneWay}"/>
                                                <TextBlock x:Name="ButtonLabel" Text="{x:Bind local:MainWindow.GetButtonLabel(IsRunning), Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <Grid x:Name="SettingsGrid" Visibility="Collapsed">
                    <StackPanel Spacing="20" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Launcher Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Game Path (FNF.exe)" FontWeight="SemiBold"/>
                            <TextBlock Text="Select where the v-slice executable is installed." Foreground="Gray" FontSize="12"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExePathTextBox" IsReadOnly="True" PlaceholderText="Ex: C:\Games\FNF\FNF.exe"/>
                                <Button Grid.Column="1" Content="Browse .exe" Click="SelectExe_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Isolated Mods Folder" FontWeight="SemiBold"/>
                            <TextBlock Text="Select the folder where your mods are stored." Foreground="Gray" FontSize="12"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ModsFolderPathTextBox" IsReadOnly="True" PlaceholderText="Ex: C:\Games\FNF_Mods"/>
                                <Button Grid.Column="1" Content="Browse Folder" Click="SelectModsFolder_Click"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="SettingsSaveStatusText" Foreground="Green" FontStyle="Italic"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </NavigationView>
        </Grid>
    </Grid>
</Window>
